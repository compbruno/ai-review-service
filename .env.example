# ─── AI Provider ─────────────────────────────────────────────
# "gemini" → usa Google Gemini API
# "ollama" → usa modelo local via Ollama
AI_PROVIDER=gemini

# Modelo a usar (deixe em branco para usar o padrão do provider)
# Gemini: gemini-2.5-flash | Ollama: codellama:13b, deepseek-coder:6.7b
AI_MODEL=

# ─── Gemini (só necessário se AI_PROVIDER=gemini) ────────────
GEMINI_API_KEY=sua_chave_aqui

# ─── Ollama (só necessário se AI_PROVIDER=ollama) ────────────
# Dentro do Docker já está configurado via docker-compose
# Para rodar local fora do Docker: http://localhost:11434
OLLAMA_URL=http://ollama:11434

# ─── Gerrit ──────────────────────────────────────────────────
GERRIT_URL=http://localhost:8081
GERRIT_USER=jenkins-bot
GERRIT_PASSWORD=sua_senha_aqui

# ─── Servidor ────────────────────────────────────────────────
PORT=3000