# AI Provider
# "gemini" -> usa Google Gemini API
# "ollama" -> usa modelo local via Ollama
AI_PROVIDER=ollama

# Modelo a usar (deixe em branco para usar o padrao do provider)
# Gemini: gemini-2.5-flash | Ollama: codellama:13b, deepseek-coder:6.7b, qwen2.5-coder:7b
AI_MODEL=

# Gemini (so necessario se AI_PROVIDER=gemini)
GEMINI_API_KEY=sua_chave_aqui

# Ollama (so necessario se AI_PROVIDER=ollama)
# Dentro do Docker ja esta configurado via docker-compose
# Para rodar local fora do Docker: http://localhost:11434
OLLAMA_URL=http://ollama:11434

# Gerrit
GERRIT_URL=http://localhost:8081
GERRIT_USER=jenkins-bot
GERRIT_PASSWORD=sua_senha_aqui

# Servidor
PORT=3000

# Datadog
# DD_API_KEY e obrigatorio para enviar dados para a sua conta Datadog.
DD_API_KEY=sua_datadog_api_key

# Use datadoghq.com para US1. Outros exemplos: datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com.
DD_SITE=datadoghq.com

# Tags principais usadas para agrupar traces, logs e metricas.
DD_ENV=local
DD_SERVICE=ai-review-service
DD_VERSION=1.0.0
